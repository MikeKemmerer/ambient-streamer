# ambient-streamer — ONE STREAM's secrets and overrides
#
# ===========================================================================
#  THIS is the file your YouTube stream key goes in — see YOUTUBE_STREAM_KEY
#  below. Global settings (ports, paths, Icecast credentials) live in the
#  root .env instead.
#
#  One copy of this file per stream. To add a stream called "lofi":
#    mkdir -p channels/lofi/{audio,images}
#    cp channels/example/.env.example channels/lofi/.env
#    chmod 600 channels/lofi/.env
#
#  channels/example/ is a template, not a running stream — it has no .env, so
#  nothing starts from it. See channels/README.md.
# ===========================================================================
#
# channels/*/.env is gitignored. This file contains a credential that grants
# publish rights to your YouTube channel — treat it like a password.

# ---------------------------------------------------------------------------
# Delivery targets
# ---------------------------------------------------------------------------
# Comma-separated, one or more of:
#
#   youtube   the public broadcast
#   video     internal HLS, full size, on your network only
#   audio     internal HLS, audio only — no video encode at all
#
# Each is served at http://<host>:<AMBIENT_HLS_PUBLISH>/<channel>/<target>/index.m3u8
# The operator preview at /<channel>/preview/index.m3u8 is always published and
# is not a target.
#
# A channel without `youtube` CANNOT reach YouTube, even with a stream key
# stored below: the composer never publishes that relay path, so the publisher
# hook has nothing to fire on.
CHANNEL_DELIVERY=youtube

# ---------------------------------------------------------------------------
# YouTube ingest
# ---------------------------------------------------------------------------
# Create the stream key by hand in YouTube Studio:
#   Studio -> Go Live -> Stream -> Stream key (paste it below)
#
# Use a PERSISTENT key ("Select stream key" -> reusable) so a restart resumes
# the same broadcast instead of needing a new one. Stream keys are never
# created or read through the YouTube API in this project.
#
# Format: xxxx-xxxx-xxxx-xxxx-xxxx
YOUTUBE_STREAM_KEY=

# Primary ingest. Leave as-is unless YouTube tells you otherwise.
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
# 480p | 720p | 1080p | 1440p | 2160p
#
# Bitrate follows the resolution automatically (see the youtube-ingest skill).
# Measured cost per 720p channel on a 7-core host is roughly 1.7 cores with
# three visualization plugins loaded, so check scaling.md before raising this.
CHANNEL_RESOLUTION=720p
CHANNEL_FPS=30

# Leave empty to inherit AMBIENT_DEFAULT_ENCODER from the global .env.
# libx264 | h264_nvenc | h264_qsv
CHANNEL_ENCODER=

# ---------------------------------------------------------------------------
# Internal video feed
# ---------------------------------------------------------------------------
# Sizes the `video` target only. Leave empty and it follows CHANNEL_RESOLUTION
# and CHANNEL_FPS — that feed is the product, not a preview, so it is not
# shrunk. Height only; the width follows at 16:9.
CHANNEL_LOCAL_HEIGHT=
CHANNEL_LOCAL_FPS=

# ---------------------------------------------------------------------------
# Resource limits
# ---------------------------------------------------------------------------
# Caps this channel so one misbehaving compositor cannot starve the others or
# anything else on the host.
CHANNEL_CPU_LIMIT=2.0
CHANNEL_MEMORY_LIMIT=2g

# ---------------------------------------------------------------------------
# Audio
# ---------------------------------------------------------------------------
# Icecast mount for this channel. Must be unique per channel.
# The fallback mount covers Liquidsoap restarts so the compositor never sees
# a gap; it is what keeps a restart from reaching YouTube at all.
CHANNEL_MOUNT=/lofi
CHANNEL_FALLBACK_MOUNT=/lofi-fallback
