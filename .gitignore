# Secrets — never commit
.env
*.env
!.env.example
!*.env.example
channels/*/.env
docker/secrets/
*.key

# Local config (example files are tracked, real ones are not)
ambient.yaml
!ambient.yaml.example
channels/*/config.yaml
!channels/example/config.yaml

# Media — large binaries, never committed.
# Ignore the CONTENTS, not the directory: git cannot re-include a file whose
# parent directory is excluded, so `channels/*/audio/` would make the !.gitkeep
# rules below silently dead.
channels/*/audio/*
channels/*/images/*
channels/*/soundboard/*
!channels/*/audio/.gitkeep
!channels/*/images/.gitkeep
!channels/*/soundboard/.gitkeep

# Shared media library — available to every channel, never duplicated per channel.
common/audio/*
common/images/*
common/bumpers/*
common/soundboard/*
!common/audio/.gitkeep
!common/images/.gitkeep
!common/bumpers/.gitkeep

# beds/ has to be re-included as a DIRECTORY before its contents can be filtered:
# `common/bumpers/*` above already excluded the directory itself, and a file
# inside an excluded directory can never be re-included.
!common/bumpers/beds/
common/bumpers/beds/*
!common/bumpers/beds/.gitkeep

# Station bumpers — generated audio. The source text lives in bumpers.yaml,
# which IS tracked: it is small, human-written, and worth versioning.
channels/*/bumpers/*
!channels/*/bumpers/.gitkeep
*.mp3
*.flac
*.ogg
*.wav
*.m4a
*.mp4
*.mkv
*.ts

# Bundled, original soundboard starters. Operator uploads remain ignored.
!common/soundboard/air-horn.wav
!common/soundboard/metal-pipe.wav
!common/soundboard/applause.wav
!common/soundboard/record-scratch.wav

# Generated artifacts
/release.env
/.release-backups/
channels/*/profiles/
channels/*/playlist.m3u
channels/*/images.list
channels/*/docker-compose.yml
common/profiles/
hls/
*.m3u8
*.log
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Editor / OS
.DS_Store
Thumbs.db

# Only the template channel ships an .env.example; a copy inside a real channel
# directory is leftover scaffolding, not something to version.
channels/*/.env.example
!channels/example/.env.example

# Spike run artifacts - regenerable, never versioned
spikes/*/out/
spikes/*/logs/

# Shared runtime state when AMBIENT_RUN_DIR points inside the repo
.run/

# Upload staging area; empty in normal operation, may orphan a .part on a crash
/.uploads/
