# Secrets — never commit
.env
*.env
!.env.example
!*.env.example
channels/*/.env
docker/secrets/
*.key

# Local config (example files are tracked, real ones are not)
ambient.yaml
!ambient.yaml.example
channels/*/config.yaml
!channels/example/config.yaml

# Media — large binaries, never committed.
# Ignore the CONTENTS, not the directory: git cannot re-include a file whose
# parent directory is excluded, so `channels/*/audio/` would make the !.gitkeep
# rules below silently dead.
channels/*/audio/*
channels/*/images/*
!channels/*/audio/.gitkeep
!channels/*/images/.gitkeep
*.mp3
*.flac
*.ogg
*.wav
*.m4a
*.mp4
*.mkv
*.ts

# Generated artifacts
channels/*/profiles/
channels/*/docker-compose.yml
hls/
*.m3u8
*.log
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Editor / OS
.DS_Store
Thumbs.db
