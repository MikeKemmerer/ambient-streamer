# ambient-streamer — FFmpeg compositor, one container per channel.
#
# Why Ubuntu 24.04 and not a hand-built FFmpeg: the distro ffmpeg 6.1.1 is built
# with --enable-libzmq, which is the whole live-control mechanism (color and
# plugin changes mutate the running filtergraph instead of restarting FFmpeg).
# A hand-built binary would be one more thing to keep patched for a 24/7 service.
#
# Multi-architecture manifest digest: release builds must not drift underneath
# an unchanged commit. Dependency refreshes update this deliberately.
ARG BASE=ubuntu:24.04@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ffmpeg \
      python3 \
      python3-pil \
      python3-zmq \
      python3-numpy \
      fonts-dejavu-core \
      gosu \
      tini \
      ca-certificates \
      tzdata \
 && rm -rf /var/lib/apt/lists/*

# Hard-fail the build if the base ever ships an FFmpeg without these. Silent
# loss of libzmq would look like "color commands stopped working" at runtime.
RUN set -eux; \
    ffmpeg -hide_banner -buildconf | grep -q -- '--enable-libzmq'; \
    ffmpeg -hide_banner -buildconf | grep -q -- '--enable-libx264'; \
    ffmpeg -hide_banner -filters | awk '{print $2}' > /tmp/filters; \
    for f in zmq azmq streamselect astreamselect showfreqs showwaves avectorscope; do \
      grep -qx "$f" /tmp/filters; \
    done; \
    rm -f /tmp/filters; \
    python3 -c 'import sys, PIL, zmq; assert sys.version_info >= (3, 10); print(PIL.__version__)'; \
    ffmpeg -version | head -1

COPY docker/liquidsoap-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

ENV PUID=1000 \
    PGID=1000 \
    HOME=/run/ambient \
    PYTHONUNBUFFERED=1

VOLUME ["/var/log/ambient"]

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/entrypoint.sh"]
# The media-pipeline lane owns this script and mounts it at /opt/ambient.
CMD ["/opt/ambient/entrypoint.sh"]
