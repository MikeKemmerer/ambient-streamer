# ambient-streamer — LAN front door on the HLS port.
#
# MediaMTX has no root page and cannot serve one: it answers 404 for `/` and has
# no static file support. So something has to sit in front to make the feeds
# discoverable, and that something must not be the control plane — routing 24/7
# media through Python would put a multi-megabit copy loop on a host where CPU
# contention has already been measured causing a YouTube outage.
#
# So: the tiny dynamic page comes from the backend, and every byte of media goes
# straight to MediaMTX untouched.
#
#   /               -> backend /directory       (a few KB of HTML)
#   /directory.json -> backend /directory.json  (the same list, for scripts)
#   everything else -> mediamtx:8888            (HLS playlists and segments)
#
# This port is unauthenticated by design — it is what VLC on the LAN opens. It
# was already unauthenticated when MediaMTX held it directly; nothing here is a
# control surface, and the backend's API is NOT proxied.
#
# Rendered by the nginx image's entrypoint, which runs envsubst over this file.
# ${...} below are Compose environment values, not nginx variables.

server {
    listen 8888;
    server_name _;

    access_log off;

    # Docker's embedded DNS, re-resolved so a restarted backend or relay does not
    # leave nginx holding a dead address for the life of the process.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Nothing here accepts a body; a large one is only ever an attack.
    client_max_body_size 1k;

    location = / {
        proxy_pass http://${AMBIENT_BACKEND_HOST}:${AMBIENT_BACKEND_PORT}/directory;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /directory.json {
        proxy_pass http://${AMBIENT_BACKEND_HOST}:${AMBIENT_BACKEND_PORT}/directory.json;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else is media. Buffering off so a live playlist is not held back
    # waiting for a buffer that will never fill.
    location / {
        proxy_pass http://${AMBIENT_RELAY_HOST}:8888;
        proxy_set_header Host $http_host;
        proxy_buffering off;
        proxy_http_version 1.1;
        # A hung segment request must fail fast rather than pin a worker.
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
