# ambient-streamer — GLOBAL settings (shared by every channel)
#
# ===========================================================================
#  YOUR YOUTUBE STREAM KEY DOES NOT GO IN THIS FILE.
#
#  Configuration is split in two, because one process streams to many
#  YouTube channels and each needs its own key:
#
#    .env                     <- this file. Ports, paths, Icecast creds.
#                                One per installation.
#
#    channels/<name>/.env     <- one per stream. THIS is where
#                                YOUTUBE_STREAM_KEY goes, along with that
#                                stream's resolution, encoder and limits.
#
#  To add a stream called "lofi":
#    mkdir -p channels/lofi/{audio,images}
#    cp channels/example/.env.example channels/lofi/.env
#    chmod 600 channels/lofi/.env
#    # then edit channels/lofi/.env and paste that stream's key
#
#  Repeat for each stream. Every directory under channels/ that contains a
#  .env is a separate 24/7 YouTube stream with its own playlist, images,
#  visualization and schedule. See channels/README.md.
# ===========================================================================
#
# Copy to .env and edit. The real .env is gitignored; never commit it.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Host paths
# ---------------------------------------------------------------------------
# Absolute path of this repository ON THE HOST. Written by scripts/install.sh;
# only change it if you move the checkout.
#
# The backend renders channels/<name>/docker-compose.yml with bind sources in
# it, and the Docker daemon resolves a bind source on the host — so the backend
# container mounts the repository at this exact path rather than at /app. If
# the two disagree, channels start with empty media directories.
AMBIENT_REPO_ROOT=

# Where channel data (audio, images, profiles) lives.
#
# Must be on a local filesystem. Do NOT point this at a CIFS/NFS mount or, on
# Docker Desktop, at a Windows drive under /mnt/c — a network or 9p round trip
# per read will stall a 24/7 stream.
AMBIENT_DATA_DIR=./channels

# Shared media library, mounted read-only into every channel so a track or
# image used by several streams is stored once. A channel can draw from this,
# from its own channels/<name>/audio and images, or from both.
AMBIENT_COMMON_DIR=./common

# Written by the containers, tailed by the web UI. Must be absolute: it is
# bind-mounted into the backend at the same path on both sides.
AMBIENT_LOG_DIR=/var/log/ambient

# Per-channel runtime state: the FFmpeg progress file the watchdog reads, plus
# now.json and health.json. This MUST be shared between the composers and the
# backend. A per-container tmpfs leaves the watchdog blind, and a blind watchdog
# restarts a perfectly healthy composer on a loop forever.
#
# A tmpfs path like /run/ambient is preferable in production so nothing survives
# a reboot; it must exist and be writable by the container user, which is what
# scripts/install.sh arranges. A repo-local ./.run works without root.
AMBIENT_RUN_DIR=/run/ambient

# ---------------------------------------------------------------------------
# Identity — containers run as this uid/gid so files stay editable on the host
# ---------------------------------------------------------------------------
PUID=1000
PGID=1000
TZ=UTC

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# Only the backend is published to the host by default. Icecast, MediaMTX RTMP
# and MediaMTX HLS stay on the internal Docker network; the backend proxies the
# HLS preview. Publishing fewer ports keeps the relay and the ZMQ control
# sockets unreachable from the LAN.
#
# 8080 and 8000 are common defaults for other self-hosted services, so this
# picks 8090 to reduce the chance of a collision. Check your own host before
# committing to it: `ss -tln` lists what is already bound, and
# scripts/install.sh refuses to start on a port something else already holds.
AMBIENT_BACKEND_PORT=8090

# Internal only — change only if they collide inside the compose network.
AMBIENT_ICECAST_PORT=8081
AMBIENT_RTMP_PORT=1935
AMBIENT_HLS_PORT=8888

# Uncomment to also expose the HLS preview directly (e.g. to open it in VLC on
# another machine without going through the backend).
# AMBIENT_HLS_PUBLISH=8888

# ---------------------------------------------------------------------------
# Backend authentication
# ---------------------------------------------------------------------------
# The backend mounts the Docker socket, which is root-equivalent on the host.
# Anyone who reaches this API and holds the token can start containers, so the
# token is the only thing between your LAN and root on this machine.
#
#   127.0.0.1  loopback only. Reach it with an SSH tunnel:
#                ssh -N -L 8090:127.0.0.1:8090 user@host
#   0.0.0.0    reachable from the LAN. The backend refuses to start this way
#                unless AMBIENT_API_TOKEN is set, but a token is not TLS: it
#                crosses the network in the clear. Put a reverse proxy with
#                HTTPS in front before exposing this beyond a trusted network,
#                and never port-forward it from the internet.
#
# This is the HOST side of the port publication. The process inside the
# container always listens on 0.0.0.0; this is what decides who can reach it.
AMBIENT_BIND_ADDRESS=127.0.0.1

# Generated by scripts/install.sh. Equivalent to: openssl rand -hex 32
AMBIENT_API_TOKEN=

# ---------------------------------------------------------------------------
# Icecast — internal audio relay between Liquidsoap and the compositor
# ---------------------------------------------------------------------------
# Liquidsoap connects as a source client; the compositor reads as a listener.
# Icecast is what makes a Liquidsoap restart invisible to the compositor, so
# these credentials are load-bearing even though nothing outside the compose
# network can reach it.
#
# Generated by scripts/install.sh. Equivalent to: openssl rand -hex 16
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=
ICECAST_RELAY_PASSWORD=

# ---------------------------------------------------------------------------
# Defaults for new channels (each channel may override in its own .env)
# ---------------------------------------------------------------------------
# libx264 | h264_nvenc | h264_qsv
#
# h264_qsv needs an Intel iGPU exposed at /dev/dri. It does NOT work on Docker
# Desktop/WSL2, and a host whose only render node belongs to a discrete NVIDIA
# card has no QSV device either — check `ls /dev/dri` and confirm the driver.
# h264_nvenc needs nvidia-container-toolkit on the host.
#
# An encoder is only used if a real test encode succeeds: `ffmpeg -encoders`
# lists encoders whose hardware is absent, so the list alone proves nothing.
AMBIENT_DEFAULT_ENCODER=libx264

AMBIENT_DEFAULT_RESOLUTION=720p
AMBIENT_DEFAULT_FPS=30
